# Salin menjadi .env lalu isi nilainya.
APP_ENV=production
APP_PORT=8087
APP_TIMEZONE=Asia/Jakarta


# Isi dengan teks acak panjang (minimal 32 karakter). Jangan dibagikan.
JWT_SECRET=
PHONE_HASH_SECRET=
COOKIE_SECURE=true

HTTP_PORT=8087
DB_USER=absensi
DB_PASSWORD=
DB_NAME=absensi

STORAGE_DRIVER=s3
# MinIO VPS private. Untuk R2, gunakan ops/cloudflare-r2.env.example.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=absensi-production
S3_PREFIX=production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Pengecualian hanya untuk http://minio:9000 di jaringan internal Compose.
S3_ALLOW_MINIO_HTTP=true

# MinIO private. Root credentials must differ from application credentials.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1
MINIO_BUCKET=absensi-production
MINIO_PREFIX=production
MINIO_ROOT_USER=absensi-root
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
# Isi S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY dengan nilai MINIO_APP_* yang sama.

# Jadwal kerja default
SCHEDULE_START=08:00
SCHEDULE_END=17:00
SCHEDULE_BREAK_START=12:00
SCHEDULE_BREAK_END=13:00
SCHEDULE_PHOTO_SESSIONS=3

# Baseline untuk satu instance API; sesuaikan berdasarkan hasil load test.
DB_MAX_CONNS=32
DB_MIN_CONNS=4
EMPLOYEE_LOGIN_PER_IP=3000
UPLOAD_WORKERS=4
MAX_ACTIVE_UPLOADS=8
CORS_ORIGINS=https://alotive.com,https://www.alotive.com
API_NETWORK=absen
DOCKER_IMAGE=USERNAME/absensi-api
IMAGE_TAG=sha-COMMIT_SHA_LENGKAP
MINIO_IMAGE=USERNAME/absensi-minio:sha-COMMIT_SHA_LENGKAP
MINIO_MC_IMAGE=USERNAME/absensi-minio-mc:sha-COMMIT_SHA_LENGKAP
