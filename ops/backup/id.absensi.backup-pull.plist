<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>id.absensi.backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ABSOLUTE/PATH/absensi-api/scripts/backup_incremental.py</string>
    <string>pull</string>
    <string>--config</string>
    <string>/ABSOLUTE/PATH/backup-client.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/absensi-backup-pull.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/absensi-backup-pull-error.log</string>
</dict>
</plist>
