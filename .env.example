# Salin menjadi .env lalu isi nilainya.
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

DATABASE_URL=postgres://absensi:absensi@localhost:5434/absensi?sslmode=disable

# Isi dengan teks acak panjang (minimal 32 karakter). Jangan dibagikan.
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
PHONE_HASH_SECRET=ganti-dengan-teks-acak-lain
COOKIE_SECURE=false

HTTP_PORT=8082
DB_PORT=5434
DB_USER=absensi
DB_PASSWORD=absensi
DB_NAME=absensi

STORAGE_DRIVER=s3
STORAGE_DIR=./storage
# MinIO development. Untuk R2, gunakan ops/cloudflare-r2.env.example.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=absensi-development
S3_PREFIX=development
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Pengecualian hanya untuk http://minio:9000 di jaringan internal Compose.
S3_ALLOW_MINIO_HTTP=true

# MinIO development only. Root credentials must differ from application credentials.
MINIO_IMAGE=absensi-minio:local
MINIO_MC_IMAGE=absensi-minio-mc:local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1
MINIO_BUCKET=absensi-development
MINIO_PREFIX=development
MINIO_ROOT_USER=absensi-root
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
# Isi S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY dengan nilai MINIO_APP_* yang sama.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Jadwal kerja default
SCHEDULE_START=08:00
SCHEDULE_END=17:00
SCHEDULE_BREAK_START=12:00
SCHEDULE_BREAK_END=13:00
SCHEDULE_PHOTO_SESSIONS=3

# Baseline untuk satu instance API; sesuaikan berdasarkan hasil load test.
DB_MAX_CONNS=32
DB_MIN_CONNS=4
EMPLOYEE_LOGIN_PER_IP=3000
UPLOAD_WORKERS=4
MAX_ACTIVE_UPLOADS=8
